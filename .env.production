# 中转站（sshzyu.com）部署专用构建配置
# 单一预置配置 + 配置内服务商类型切换（providerPresets）：
#   - 只有一个配置项；配置内可在 openai / gemini 两种服务器类型间切换
#   - 两种类型请求地址固定为同一官网根地址（openai 分支由 buildApiUrl 自动补 /v1 前缀），不可修改
#   - 模型 ID 仅预填（openai=gpt-image2 / gemini=gemini-3.1-flash-image-preview），用户可自行修改
#   - API Key 由用户自行申请后填写
VITE_DEFAULT_API_URL=embedded-config:
VITE_LOCK_PRESET_CONFIG_PARAMS=true
VITE_PRESET_UNLOCKED_FIELDS=model
